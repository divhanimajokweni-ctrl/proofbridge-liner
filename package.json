{
  "name": "proofbridge-liner",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "webhook:worker": "bun --hot scripts/webhook-worker.js",
    "webhook:admin": "bun --hot scripts/admin-worker.js",
    "webhook:create-topics": "bun scripts/create-topics.js",
    "webhook:rotate-secret": "bun scripts/rotate-webhook-secret.js",
    "watchdog": "bun run scripts/watchdog.js",
    "watchdog:prod": "NODE_ENV=production bun run scripts/watchdog.js",
    "hardhat:compile": "hardhat compile",
    "watch:dev-sync": "bun run scripts/auto-deploy-watcher.js",
    "watch:dev-sync:dry": "DRY_RUN=true bun run scripts/auto-deploy-watcher.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
