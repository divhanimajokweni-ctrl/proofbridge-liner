{
  "name": "proofbridge-liner",
  "version": "1.0.0-rc1",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:all": "turbo build",
    "test": "turbo test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "chaos": "npx tsx tests/chaos-gate-bench.ts",
    "seed": "npx tsx scripts/seed-trust-context.ts",
    "kernel": "npx tsx scripts/mock-lindiwe-kernel.ts",
    "run:all": "./scripts/run-all.sh",
    "db:push": "drizzle-kit push --config ./lib/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config ./lib/db/drizzle.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.x"
  },
  "license": "MIT",
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "next": "16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
