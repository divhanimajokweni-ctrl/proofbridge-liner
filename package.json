{
  "name": "proofbridge-liner",
  "version": "1.0.0-rc1",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "contracts"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build --force && next build",
    "build:all": "turbo build",
    "test": "vitest run",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "chaos": "npx tsx tests/chaos-gate-bench.ts",
    "seed": "npx tsx scripts/seed-trust-context.ts",
    "kernel": "npx tsx scripts/mock-lindiwe-kernel.ts",
    "run:all": "./scripts/run-all.sh",
    "db:push": "drizzle-kit push --config ./lib/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config ./lib/db/drizzle.config.ts",
    "gate": "bash air/run-pipeline.sh",
    "air:compile": "bash air/run-pipeline.sh",
    "air:seed": "node air/pipeline/seed-evidence.js",
    "air:collect": "node air/pipeline/1_collect.js",
    "air:normalize": "node air/pipeline/2_normalize.js",
    "air:infer": "node air/pipeline/3_infer.js",
    "air:govern": "node air/pipeline/4_govern.js",
    "air:codegen": "node air/pipeline/5_codegen.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vercel": "^42.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.x"
  },
  "license": "MIT",
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@upstash/redis": "^1.38.0",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.33.0",
    "drizzle-zod": "^0.5.1",
    "ethers": "^6.17.0",
    "firebase": "^12.16.0",
    "framer-motion": "^12.42.2",
    "jsonwebtoken": "^9.0.3",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.17.2",
    "shadcn": "^4.13.0",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "js-yaml": "^4.3.0"
  }
}
