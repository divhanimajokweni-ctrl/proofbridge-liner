{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "active",
    "commercial",
    "scripts",
    ".zscripts",
    "agent-ctx",
    "validation",
    "supabase",
    "_app_legacy",
    "upload",
    "docs",
    "config",
    ".claude",
    "circuits",
    "mini-services",
    "compliance",
    ".vscode",
    "__tests__",
    "examples",
    "shared",
    "evidence",
    "server",
    ".vvu",
    "schemas",
    "outreach-docs",
    ".kilocode",
    "disposable-storage",
    "products",
    "test",
    "packages",
    "VVU-VAL-001",
    "pipeline",
    ".github",
    "prover",
    "air",
    "vvu-mcp-server",
    "public",
    "lib",
    ".agents",
    "infra",
    "ai-gateway",
    "vvu-immortal",
    "ive-output",
    ".husky",
    "tests",
    "secrets",
    "e2e",
    "db",
    "contracts",
    ".kilo",
    "download",
    "script",
    "prisma",
    "open-source"
  ]
}
