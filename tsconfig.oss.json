{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./open-source",
    "outDir": "./dist/open-source",
    "paths": {
      "@vvu/shared/*": ["shared/*"],
      "@vvu/kernel/*": ["src/lib/kernel/*"],
      "@vvu/commercial/*": ["./node_modules/@vvu/blocked-commercial/*"]
    }
  },
  "include": [
    "open-source/**/*",
    "shared/**/*",
    "src/lib/kernel/**/*",
    "src/engine/**/*",
    "src/signer/ed25519.ts",
    "src/signer/ecdsa-p384.ts",
    "src/signer/rsa-pss.ts",
    "src/storage/local-worm.ts"
  ],
  "exclude": [
    "commercial/**/*",
    "node_modules"
  ]
}
