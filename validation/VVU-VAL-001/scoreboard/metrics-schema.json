{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VVU-VAL-001 Metrics Schema",
  "description": "Schema for the metrics.json consumed by the Validation Index computation and the scoreboard.",
  "type": "object",
  "properties": {
    "elapsed_s": { "type": "number", "description": "Total elapsed seconds since T=0" },
    "elapsed_min": { "type": "integer", "description": "Total elapsed simulated minutes" },
    "phase_id": { "type": "string", "enum": ["P1","P2","P3","P4","P5","P6","P7"] },
    "circuit_breaker": { "type": "string", "enum": ["NORMAL","DEGRADED","RECOVERING","FAIL-CLOSED"] },
    "facts_accepted": { "type": "integer" },
    "facts_queued": { "type": "integer" },
    "facts_merged": { "type": "integer" },
    "facts_rejected": { "type": "integer" },
    "policy_violations": { "type": "integer" },
    "policy_violations_handled": { "type": "integer", "description": "Violations that produced a Failure Fact (not a crash)" },
    "cpu_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "ram_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "queue_depth": { "type": "integer" },
    "latency_p99_ms": { "type": "number" },
    "proof_count": { "type": "integer" },
    "tee_status": { "type": "string", "enum": ["ATTESTED","QUARANTINED"] },
    "replay_status": { "type": "string", "enum": ["VERIFIED","DIVERGENT","PENDING"] },
    "mmr_root": { "type": "string", "pattern": "^[0-9A-Fa-f]+$" },
    "fact_log_checksum": { "type": "string", "description": "SHA-256 of the live Fact Log" },
    "replay_checksum": { "type": "string", "description": "SHA-256 of the replayed Fact Log (must match fact_log_checksum)" },
    "fail_closed_s": { "type": "number", "description": "Seconds spent in FAIL-CLOSED state" },
    "spoofed_payloads_injected": { "type": "integer" },
    "spoofed_payloads_quarantined": { "type": "integer" },
    "merge_count": { "type": "integer" },
    "merge_conflicts_observed": { "type": "integer" },
    "evidence_bundles_total": { "type": "integer" },
    "evidence_bundles_verified": { "type": "integer" }
  },
  "required": ["elapsed_s","circuit_breaker","facts_accepted","mmr_root"]
}
