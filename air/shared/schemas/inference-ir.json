{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inference IR",
  "description": "Intermediate Representation for derived inference results with explainable confidence scoring",
  "type": "object",
  "required": ["inferenceId", "evidenceReferences", "capabilityId", "conclusion", "confidence", "explainability", "derivedAt"],
  "properties": {
    "inferenceId": {
      "type": "string",
      "description": "Unique identifier for this inference entry"
    },
    "evidenceReferences": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Array of Evidence IR IDs that contributed to this inference"
    },
    "capabilityId": {
      "type": "string",
      "description": "Identifier of the capability being evaluated"
    },
    "conclusion": {
      "type": "string",
      "enum": ["PASS", "FAIL", "PENDING"],
      "description": "Derived conclusion from evidence analysis"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Floating-point confidence score between 0.00 and 1.00"
    },
    "explainability": {
      "type": "object",
      "required": ["contributors"],
      "properties": {
        "contributors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["factor", "weight", "satisfied"],
            "properties": {
              "factor": {
                "type": "string",
                "description": "Name of the explanatory factor"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Relative weight of this factor in the confidence calculation"
              },
              "satisfied": {
                "type": "boolean",
                "description": "Whether this factor's conditions are met"
              }
            }
          },
          "description": "Ordered list of explainable contributors to the confidence score"
        }
      }
    },
    "derivedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of when this inference was computed"
    }
  },
  "additionalProperties": false
}
