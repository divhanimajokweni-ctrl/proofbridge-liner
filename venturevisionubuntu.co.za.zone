; ─────────────────────────────────────────────────────────────────────
; BIND zone file — venturevisionubuntu.co.za
; Target: Vercel DNS (ns1.vercel-dns.com / ns2.vercel-dns.com)
; Generated: 2026-07-30
; ─────────────────────────────────────────────────────────────────────
$TTL    3600
@       IN      SOA     ns1.vercel-dns.com.     hostmaster.vercel-dns.com. (
                        2026073001      ; serial
                        3600            ; refresh
                        900             ; retry
                        1209600         ; expire
                        300             ; minimum TTL
                        )

; Nameservers — Vercel
@       IN      NS      ns1.vercel-dns.com.
@       IN      NS      ns2.vercel-dns.com.

; CAA — authorised certificate issuers
@       IN      CAA     0 issue "letsencrypt.org"
@       IN      CAA     0 issue "sectigo.com"
@       IN      CAA     0 issue "pki.goog"
@       IN      CAA     0 iodef "mailto:hostmaster@venturevisionubuntu.co.za"

; Apex — ALIAS resolves to Vercel edge IPs
@       IN      ALIAS   cname.vercel-dns.com.

; www subdomain
www     IN      CNAME   cname.vercel-dns.com.

; Wildcard subdomain — route all subdomains to Vercel
*       IN      ALIAS   cname.vercel-dns-017.com.

; ─────────────────────────────────────────────────────────────────────
; Email (MX) — optional, configure if you use custom email hosting
; @       IN      MX      10      mail.venturevisionubuntu.co.za.
; ─────────────────────────────────────────────────────────────────────
