# CRAFT Ingestion Worker
# Cross-Modal Retrieval-Augmented Fine-Tuning for Lean 4 proofs
# Base: Python 3.11 slim with PyTorch CUDA support
FROM python:3.11-slim-bookworm

LABEL maintainer="VVU <compliance-fabric>"
LABEL description="CRAFT ingestion worker — parses .lean files via tree-sitter, embeds via sentence-transformers, upserts to Milvus"

# Install system dependencies for tree-sitter-lean build + curl healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for layer caching
COPY scripts/craft/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Deploy ingestion scripts
COPY scripts/craft/ /app/craft/
WORKDIR /app

# Verify GPU availability at runtime
RUN python3 -c "import torch; print(f'[CRAFT] PyTorch {torch.__version__} — CUDA available: {torch.cuda.is_available()}')" || echo "[CRAFT] WARNING: GPU not found, falling back to CPU"

# Default: run continuous ingestion loop
ENTRYPOINT ["python3", "/app/craft/ingest.py"]
CMD ["--watch", "/workspace", "--interval", "60"]
