# Required: Anthropic API key for the Claude Sonnet model
ANTHROPIC_API_KEY=

# Required: Firecrawl API key for web scraping and search
FIRECRAWL_API_KEY=

# Optional: OpenAI API key (fallback model)
# OPENAI_API_KEY=

# Optional: GitHub token for PR creation and repository operations
# GITHUB_TOKEN=

# VVU MCP Server URL (default: localhost:3001)
# VVU_MCP_URL=http://localhost:3001
