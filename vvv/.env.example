# ProofBridge Liner public-surface environment contract.
# Set real values in Vercel or Replit secrets. Do not commit real keys.

# RS256 receipt authority. Use a PEM private key with escaped newlines or a base64-encoded PEM.
PROOFBRIDGE_RECEIPT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
PROOFBRIDGE_RECEIPT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
PROOFBRIDGE_RECEIPT_KEY_ID=proofbridge-gate1-rs256

# Liquidity Leap telemetry ingress shared header. Unity sends this as x-proofbridge-telemetry-key.
LIQUIDITY_LEAP_TELEMETRY_KEY=replace-with-random-ingress-key

# Optional: override base threshold.
# BASE_THRESHOLD=0.6
