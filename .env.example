# ProofBridge Liner - Environment Variables

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=file:./db/custom.db

# NextAuth.js Configuration
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google Maps API Key (browser key, restricted to your domain)
# Create at: https://console.cloud.google.com/apis/credentials
# Restrict: HTTP referrers > yourdomain.com/*, APIs: Maps JavaScript only
GOOGLE_MAPS_API_KEY=your-google-maps-browser-key-here
