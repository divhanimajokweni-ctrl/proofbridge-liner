# ProofBridge Liner — Environment Configuration
# Copy this file to .env and fill in your values

# ─── Project Identity ───────────────────────────────────────────────
# Owner: Divhani Majokweni <divhanimajokweni@gmail.com>
# GitHub: divhanimajokweni-ctrl | Vercel: divhanimajokweni-1651s-projects
# ⚠️ ALL dev/prod operations use divhanimajokweni@gmail.com ONLY

# Database (required)
# For local dev: SQLite
DATABASE_URL=file:./dev.db
# For production: PostgreSQL (Supabase or other)
# DATABASE_URL=postgresql://user:password@host:5432/db

# Zoo API (required for CAD + Agent features)
ZOO_API_TOKEN=your_zoo_api_token_here

# Supabase (optional — features degrade gracefully if missing)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk Auth (optional — app works without auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Resend Email (optional)
RESEND_API_KEY=
