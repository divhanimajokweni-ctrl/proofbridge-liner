# RPC URLs
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your-api-key
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Private key (DO NOT COMMIT!)
PRIVATE_KEY=your_private_key_here

# Authorized verifier address
AUTHORIZED_VERIFIER=0xYourVerifierAddressHere

# Contract address (after deployment)
CONTRACT_ADDRESS=0xYourContractAddressHere

# API Keys
ETHERSCAN_API_KEY=your_etherscan_api_key

# Kernel secret for /api/verify bearer auth
KERNEL_SECRET=your_kernel_secret_here

# Oracle wallet for on-chain updateProof calls
ORACLE_PRIVATE_KEY=your_oracle_private_key_here

# TEE attestation mode
TEE_MODE=software-attested
TEE_ENCLAVE_PRIVATE_KEY_PEM=

# ── Supabase (Auth + Database) ─────────────────────────────────────
# For LOCAL DEVELOPMENT: leave these empty to use DB-only (Drizzle) fallback path.
# For PRODUCTION: set your real Supabase project credentials.
# WARNING: Do NOT use placeholder values like "<your-project-ref>" — createClient
# will throw "Invalid supabaseUrl" and onboarding will fail.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT & Session secrets
VVU_JWT_SECRET=vvu_brain_absolute_cryptographic_signing_key_vector
VVU_SESSION_SECRET=dev-session-secret

# ── Upstash Redis (Billing & State Store) ──────────────────────────
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"

# ── Stripe (Global Card Payments) ──────────────────────────────────
STRIPE_SECRET_KEY="sk_live_your_stripe_secret"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# ── Stitch (South African Open Banking Payments) ───────────────────
STITCH_CLIENT_ID="stitch_client_id"
STITCH_CLIENT_SECRET="stitch_client_secret"
STITCH_WEBHOOK_SECRET="stitch_webhook_hmac_secret"

# ── Multi-Channel Alerting ─────────────────────────────────────────
SLACK_OPERATIONAL_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
DISCORD_OPERATIONAL_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR/WEBHOOK/ID"

# ── WhatsApp Baileys Daemon ────────────────────────────────────────
WHATSAPP_AUTH_DIR="auth_store_whatsapp"
WHATSAPP_HEALTH_PORT=3001
WHATSAPP_ADMIN_PHONES="27821234567,27719876543"

# ── Fireworks AI / Gemma (LLM Judge / AMD Hackathon) ───────────────
# Used by lib/compliance/gemma-judge.ts for secondary compliance opinion.
# Get from https://fireworks.ai → API Keys (free credits available via AMD Hackathon)
FIREWORKS_API_KEY="fw_your_fireworks_api_key"

# ── Application URLs ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
