{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "isolatedModules": false,
    "incremental": false,
    "noEmit": false,
    "types": ["node", "hardhat", "@nomicfoundation/hardhat-ethers", "@nomicfoundation/hardhat-chai-matchers", "mocha", "chai"]
  },
  "include": [
    "hardhat.config.ts",
    "test/**/*.ts",
    "scripts/hardhat/**/*.ts",
    "typechain-types/**/*.ts"
  ],
  "exclude": ["node_modules", "tests", "src"]
}
