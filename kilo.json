{
  "$schema": "https://app.kilo.ai/config.json",
  "name": "VVU Trust Runtime — Immortal Knowledge Engine",
  "description": "Trust Runtime agents — colony model, MCP server, Immortal Knowledge Engine E2E pipeline with Firecrawl, SQLite, and GitHub",
  "model": "claude-3-5-sonnet-20241022",
  "small_model": "claude-3-5-haiku-20241022",
  "mcp": {
    "vvu": {
      "type": "local",
      "command": ["node", "/home/runner/workspace/vvu-mcp-server/index.js"],
      "enabled": true
    },
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp@latest"],
      "enabled": true,
      "environment": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    }
  }
}
