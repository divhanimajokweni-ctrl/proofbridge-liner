{
  "$schema": "https://app.kilo.ai/config.json",
  "indexing": {
    "vectorStore": "lancedb"
  },
  "skills": {
    "paths": [
      ".agents/skills"
    ]
  },
  "snapshot": false,
  "default_agent": "headless",
  "server": {
    "port": 4096,
    "hostname": "127.0.0.1",
    "mdns": false
  }
}
