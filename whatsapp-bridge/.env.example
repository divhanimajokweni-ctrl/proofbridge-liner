# WhatsApp Bridge Configuration
# 1. Scan QR with WhatsApp app > Linked Devices
# 2. Add authorized phone numbers (international format, comma-separated)
# 3. Ensure this .env is NOT tracked (add to .gitignore)

# Bridge server port
WHATSAPP_BRIDGE_PORT=3456

# Path to persist WhatsApp auth session (cookies, local storage)
WHATSAPP_SESSION_PATH=./.wwebjs_auth

# Workspace handler endpoint (Next.js route in this project)
KILO_API_ENDPOINT=http://localhost:3000/api/whatsapp/handler

# Optional: restrict to specific senders (comma-separated, + international format)
# Example: ALLOWED_SENDERS=+27123456789,+27881234567
ALLOWED_SENDERS=
