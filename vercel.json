{
  "version": 2,
  "name": "vvu-enterprise-platform",
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "bun install",
  "outputDirectory": ".next",
  "regions": ["cpt1"],
  "github": {
    "enabled": true,
    "silent": true
  },
  "env": {
    "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY": "@google-maps-api-key"
  }
}
