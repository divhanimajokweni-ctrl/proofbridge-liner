{
  "version": 2,
  "name": "vvu-enterprise-platform",
  "framework": "nextjs",
  "buildCommand": "bun run build",
  "devCommand": "bun run dev",
  "installCommand": "bun install",
  "outputDirectory": ".next",
  "regions": ["cpt1"],
  "github": {
    "enabled": true,
    "silent": true
  },
  "routes": [
    { "src": "/vvu-enterprise-platform.html", "dest": "/public/vvu-enterprise-platform.html" },
    { "src": "/vvu-spatial-intelligence.html", "dest": "/public/vvu-spatial-intelligence.html" },
    { "src": "/searm1-b2b-dashboard.html", "dest": "/public/searm1-b2b-dashboard.html" },
    { "src": "/vvu-gis-bench.html", "dest": "/public/vvu-gis-bench.html" },
    { "src": "/three/(.*)", "dest": "/public/three/$1" },
    { "src": "/brand/(.*)", "dest": "/public/brand/$1" },
    { "src": "/vvv/(.*)", "dest": "/public/vvv/$1" }
  ],
  "env": {
    "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY": "AIzaSyDvWTTuSKTIbs1g8m5XIjh3eWZSPb8M_a0"
  }
}
