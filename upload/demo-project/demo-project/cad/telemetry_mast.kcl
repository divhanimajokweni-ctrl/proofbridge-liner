// Telemetry mast
// Flanged communications mast with antenna bars and junction enclosure.
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

import unitBox from "unit_box.kcl"
import unitCylinder from "unit_cylinder.kcl"

mastHeight = 1900mm
mastColor = "#a6b0b6"
hardwareColor = "#495963"

baseFlange = clone(unitCylinder)
  |> scale(
       x = 250mm / 1mm,
       y = 250mm / 1mm,
       z = 24mm / 1mm,
       global = true,
     )
  |> translate(z = -mastHeight / 2, global = true)
  |> appearance(color = mastColor, metalness = 84, roughness = 28)
baseCollar = clone(unitCylinder)
  |> scale(
       x = 115mm / 1mm,
       y = 115mm / 1mm,
       z = 140mm / 1mm,
       global = true,
     )
  |> translate(z = -mastHeight / 2 + 75mm, global = true)
  |> appearance(color = mastColor, metalness = 82, roughness = 30)
mastTube = clone(unitCylinder)
  |> scale(
       x = 58mm / 1mm,
       y = 58mm / 1mm,
       z = (mastHeight - 180mm) / 1mm,
       global = true,
     )
  |> translate(z = 20mm, global = true)
  |> appearance(color = mastColor, metalness = 82, roughness = 30)

junctionBox = clone(unitBox)
  |> scale(
       x = 150mm / 1mm,
       y = 110mm / 1mm,
       z = 230mm / 1mm,
       global = true,
     )
  |> translate(x = 110mm, z = 260mm, global = true)
  |> appearance(color = hardwareColor, metalness = 58, roughness = 46)
antennaBarA = clone(unitCylinder)
  |> scale(
       x = 28mm / 1mm,
       y = 28mm / 1mm,
       z = 360mm / 1mm,
       global = true,
     )
  |> translate(x = 92mm, z = 650mm, global = true)
  |> appearance(color = hardwareColor, metalness = 68, roughness = 38)
antennaBarB = clone(antennaBarA)
  |> translate(x = -184mm, z = -90mm, global = true)
antennaCrossbar = clone(unitBox)
  |> scale(
       x = 230mm / 1mm,
       y = 34mm / 1mm,
       z = 34mm / 1mm,
       global = true,
     )
  |> translate(z = 600mm, global = true)
  |> appearance(color = hardwareColor, metalness = 70, roughness = 36)

export allBodies = flatten([
  baseFlange,
  baseCollar,
  mastTube,
  junctionBox,
  antennaBarA,
  antennaBarB,
  antennaCrossbar
])
