// Pump and drive module
// Skid-mounted pump, motor, coupling, bearing housing, and gearbox envelopes.
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

import unitBox from "unit_box.kcl"
import unitCylinder from "unit_cylinder.kcl"

baseColor = "#515e67"
motorColor = "#3e5966"
pumpColor = "#7c8790"
couplingColor = "#c29b53"

basePlate = clone(unitBox)
  |> scale(
       x = 720mm / 1mm,
       y = 600mm / 1mm,
       z = 30mm / 1mm,
       global = true,
     )
  |> translate(z = -245mm, global = true)
  |> appearance(color = baseColor, metalness = 74, roughness = 40)

motorBody = clone(unitCylinder)
  |> scale(
       x = 270mm / 1mm,
       y = 270mm / 1mm,
       z = 340mm / 1mm,
       global = true,
     )
  |> rotate(axis = Y, angle = 90deg, global = false)
  |> translate(x = -160mm, z = -45mm, global = true)
  |> appearance(color = motorColor, metalness = 64, roughness = 44)
motorRearCap = clone(unitCylinder)
  |> scale(
       x = 290mm / 1mm,
       y = 290mm / 1mm,
       z = 34mm / 1mm,
       global = true,
     )
  |> rotate(axis = Y, angle = 90deg, global = false)
  |> translate(x = -347mm, z = -45mm, global = true)
  |> appearance(color = pumpColor, metalness = 72, roughness = 38)

pumpCasing = clone(unitCylinder)
  |> scale(
       x = 340mm / 1mm,
       y = 340mm / 1mm,
       z = 180mm / 1mm,
       global = true,
     )
  |> rotate(axis = Y, angle = 90deg, global = false)
  |> translate(x = 235mm, z = -30mm, global = true)
  |> appearance(color = pumpColor, metalness = 76, roughness = 36)
pumpFrontFlange = clone(unitCylinder)
  |> scale(
       x = 390mm / 1mm,
       y = 390mm / 1mm,
       z = 28mm / 1mm,
       global = true,
     )
  |> rotate(axis = Y, angle = 90deg, global = false)
  |> translate(x = 339mm, z = -30mm, global = true)
  |> appearance(color = pumpColor, metalness = 80, roughness = 32)

couplingGuard = clone(unitCylinder)
  |> scale(
       x = 150mm / 1mm,
       y = 150mm / 1mm,
       z = 170mm / 1mm,
       global = true,
     )
  |> rotate(axis = Y, angle = 90deg, global = false)
  |> translate(x = 90mm, z = -40mm, global = true)
  |> appearance(color = couplingColor, metalness = 68, roughness = 38)

gearboxBody = clone(unitBox)
  |> scale(
       x = 260mm / 1mm,
       y = 330mm / 1mm,
       z = 300mm / 1mm,
       global = true,
     )
  |> translate(x = -70mm, z = 155mm, global = true)
  |> appearance(color = "#56636d", metalness = 70, roughness = 40)
gearboxTop = clone(unitCylinder)
  |> scale(
       x = 90mm / 1mm,
       y = 90mm / 1mm,
       z = 80mm / 1mm,
       global = true,
     )
  |> translate(x = -70mm, z = 345mm, global = true)
  |> appearance(color = couplingColor, metalness = 68, roughness = 36)

leftMount = clone(unitBox)
  |> scale(
       x = 190mm / 1mm,
       y = 90mm / 1mm,
       z = 70mm / 1mm,
       global = true,
     )
  |> translate(
       x = -180mm,
       y = -205mm,
       z = -195mm,
       global = true,
     )
  |> appearance(color = baseColor, metalness = 74, roughness = 40)
rightMount = clone(leftMount)
  |> translate(y = 410mm, global = true)
pumpMount = clone(leftMount)
  |> translate(x = 400mm, global = true)
pumpMountRear = clone(rightMount)
  |> translate(x = 400mm, global = true)

export allBodies = flatten([
  basePlate,
  motorBody,
  motorRearCap,
  pumpCasing,
  pumpFrontFlange,
  couplingGuard,
  gearboxBody,
  gearboxTop,
  leftMount,
  rightMount,
  pumpMount,
  pumpMountRear
])
