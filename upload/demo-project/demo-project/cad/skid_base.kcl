// Hydro-Gateway skid base
// Open structural skid with perimeter rails, crossmembers, equipment pads, and pipe supports.
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

import unitBox from "unit_box.kcl"

skidLength = 2280mm
skidDepth = 2400mm
railWidth = 120mm
railHeight = 140mm
crossmemberLength = skidDepth - (2 * railWidth)
padThickness = 16mm
steelColor = "#35414b"
padColor = "#65727d"

leftLongRail = clone(unitBox)
  |> scale(
       x = skidLength / 1mm,
       y = railWidth / 1mm,
       z = railHeight / 1mm,
       global = true,
     )
  |> translate(y = -skidDepth / 2 + railWidth / 2, global = true)
  |> appearance(color = steelColor, metalness = 76, roughness = 40)
rightLongRail = clone(leftLongRail)
  |> translate(y = skidDepth - railWidth, global = true)

frontCrossmember = clone(unitBox)
  |> scale(
       x = railWidth / 1mm,
       y = crossmemberLength / 1mm,
       z = railHeight / 1mm,
       global = true,
     )
  |> translate(x = -skidLength / 2 + railWidth / 2, global = true)
  |> appearance(color = steelColor, metalness = 76, roughness = 40)
rearCrossmember = clone(frontCrossmember)
  |> translate(x = skidLength - railWidth, global = true)
innerCrossmemberA = clone(frontCrossmember)
  |> translate(x = 650mm, global = true)
innerCrossmemberB = clone(frontCrossmember)
  |> translate(x = 1300mm, global = true)
innerCrossmemberC = clone(frontCrossmember)
  |> translate(x = 1950mm, global = true)

pipeMountPad = clone(unitBox)
  |> scale(
       x = 980mm / 1mm,
       y = 760mm / 1mm,
       z = padThickness / 1mm,
       global = true,
     )
  |> translate(
       x = -570mm,
       y = -690mm,
       z = railHeight / 2 + padThickness / 2,
       global = true,
     )
  |> appearance(color = padColor, metalness = 72, roughness = 42)
centerMountPad = clone(unitBox)
  |> scale(
       x = 760mm / 1mm,
       y = 760mm / 1mm,
       z = padThickness / 1mm,
       global = true,
     )
  |> translate(
       x = 390mm,
       y = -690mm,
       z = railHeight / 2 + padThickness / 2,
       global = true,
     )
  |> appearance(color = padColor, metalness = 72, roughness = 42)
rearMountPad = clone(unitBox)
  |> scale(
       x = 2060mm / 1mm,
       y = 800mm / 1mm,
       z = padThickness / 1mm,
       global = true,
     )
  |> translate(y = 690mm, z = railHeight / 2 + padThickness / 2, global = true)
  |> appearance(color = padColor, metalness = 72, roughness = 42)

pipeSupportA = clone(unitBox)
  |> scale(
       x = 100mm / 1mm,
       y = 250mm / 1mm,
       z = 84mm / 1mm,
       global = true,
     )
  |> translate(
       x = -900mm,
       y = -690mm,
       z = 128mm,
       global = true,
     )
  |> appearance(color = steelColor, metalness = 76, roughness = 40)
pipeSupportB = clone(pipeSupportA)
  |> translate(x = 360mm, global = true)

frontLeftFoot = clone(unitBox)
  |> scale(
       x = 220mm / 1mm,
       y = 220mm / 1mm,
       z = 20mm / 1mm,
       global = true,
     )
  |> translate(
       x = -990mm,
       y = -1050mm,
       z = -railHeight / 2 - 10mm,
       global = true,
     )
  |> appearance(color = padColor, metalness = 78, roughness = 36)
frontRightFoot = clone(frontLeftFoot)
  |> translate(y = 2100mm, global = true)
rearLeftFoot = clone(frontLeftFoot)
  |> translate(x = 1980mm, global = true)
rearRightFoot = clone(rearLeftFoot)
  |> translate(y = 2100mm, global = true)

export skidBase = flatten([
  leftLongRail,
  rightLongRail,
  frontCrossmember,
  rearCrossmember,
  innerCrossmemberA,
  innerCrossmemberB,
  innerCrossmemberC,
  pipeMountPad,
  centerMountPad,
  rearMountPad,
  pipeSupportA,
  pipeSupportB,
  frontLeftFoot,
  frontRightFoot,
  rearLeftFoot,
  rearRightFoot
])
