// Pressure pipe spool
// Hollow DN260-style spool with 335 mm flanges and staged true bolt-hole cuts.
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

pipeLength = 760mm
pipeOuterDiameter = 280mm
pipeInnerDiameter = 260mm
flangeOuterDiameter = 335mm
flangeThickness = 24mm
boltCircleDiameter = 290mm
boltHoleDiameter = 22mm
pipeColor = "#76838c"
flangeColor = "#9aa4aa"

pipeSectionSketch = sketch(on = XY) {
  outerCircle = circle(start = [var 140mm, var 0mm], center = [var 0mm, var 0mm])
  innerCircle = circle(start = [var 130mm, var 0mm], center = [var 0mm, var 0mm])

  coincident([outerCircle.center, ORIGIN])
  coincident([innerCircle.center, ORIGIN])
  horizontal([outerCircle.start, outerCircle.center])
  horizontal([innerCircle.start, innerCircle.center])
  diameter(outerCircle) == pipeOuterDiameter
  diameter(innerCircle) == pipeInnerDiameter
}
pipeSectionRegion = region(point = [135mm, 0mm], sketch = pipeSectionSketch)
pipeShell = extrude(pipeSectionRegion, length = pipeLength, symmetric = true)
  |> appearance(color = pipeColor, metalness = 74, roughness = 38)
pipeSectionSketchHidden = hide(pipeSectionSketch)

flangeOuterSketch = sketch(on = XY) {
  outerCircle = circle(start = [var 167.5mm, var 0mm], center = [var 0mm, var 0mm])

  coincident([outerCircle.center, ORIGIN])
  horizontal([outerCircle.start, outerCircle.center])
  diameter(outerCircle) == flangeOuterDiameter
}
flangeOuterRegion = region(segments = [flangeOuterSketch.outerCircle])
flangeOuterBlank = extrude(flangeOuterRegion, length = flangeThickness, symmetric = true)
flangeOuterSketchHidden = hide(flangeOuterSketch)

flangeBoreSketch = sketch(on = XY) {
  boreCircle = circle(start = [var 140mm, var 0mm], center = [var 0mm, var 0mm])

  coincident([boreCircle.center, ORIGIN])
  horizontal([boreCircle.start, boreCircle.center])
  diameter(boreCircle) == pipeOuterDiameter
}
flangeBoreRegion = region(segments = [flangeBoreSketch.boreCircle])
flangeBoreCutter = extrude(flangeBoreRegion, length = flangeThickness + 12mm, symmetric = true)
flangeOuterRing = subtract([flangeOuterBlank], tools = [flangeBoreCutter])
flangeBoreSketchHidden = hide(flangeBoreSketch)

flangeBoltSketch = sketch(on = XY) {
  boltCenter = point(at = [var 145mm, var 0mm])
  boltHole = circle(start = [var 156mm, var 0mm], center = [var 145mm, var 0mm])

  horizontalDistance([ORIGIN, boltCenter]) == boltCircleDiameter / 2
  verticalDistance([ORIGIN, boltCenter]) == 0mm
  coincident([boltHole.center, boltCenter])
  horizontal([boltHole.start, boltHole.center])
  diameter(boltHole) == boltHoleDiameter
}
flangeBoltRegion = region(segments = [flangeBoltSketch.boltHole])
boltCutter01 = extrude(flangeBoltRegion, length = flangeThickness + 12mm, symmetric = true)
boltCutter02 = clone(boltCutter01)
  |> rotate(axis = Z, angle = 30deg, global = true)
boltCutter03 = clone(boltCutter01)
  |> rotate(axis = Z, angle = 60deg, global = true)
boltCutter04 = clone(boltCutter01)
  |> rotate(axis = Z, angle = 90deg, global = true)
boltCutter05 = clone(boltCutter01)
  |> rotate(axis = Z, angle = 120deg, global = true)
boltCutter06 = clone(boltCutter01)
  |> rotate(axis = Z, angle = 150deg, global = true)
boltCutter07 = clone(boltCutter01)
  |> rotate(axis = Z, angle = 180deg, global = true)
boltCutter08 = clone(boltCutter01)
  |> rotate(axis = Z, angle = 210deg, global = true)
boltCutter09 = clone(boltCutter01)
  |> rotate(axis = Z, angle = 240deg, global = true)
boltCutter10 = clone(boltCutter01)
  |> rotate(axis = Z, angle = 270deg, global = true)
boltCutter11 = clone(boltCutter01)
  |> rotate(axis = Z, angle = 300deg, global = true)
boltCutter12 = clone(boltCutter01)
  |> rotate(axis = Z, angle = 330deg, global = true)

flangeHole01 = subtract([flangeOuterRing], tools = [boltCutter01])
flangeHole02 = subtract([flangeHole01], tools = [boltCutter02])
flangeHole03 = subtract([flangeHole02], tools = [boltCutter03])
flangeHole04 = subtract([flangeHole03], tools = [boltCutter04])
flangeHole05 = subtract([flangeHole04], tools = [boltCutter05])
flangeHole06 = subtract([flangeHole05], tools = [boltCutter06])
flangeHole07 = subtract([flangeHole06], tools = [boltCutter07])
flangeHole08 = subtract([flangeHole07], tools = [boltCutter08])
flangeHole09 = subtract([flangeHole08], tools = [boltCutter09])
flangeHole10 = subtract([flangeHole09], tools = [boltCutter10])
flangeHole11 = subtract([flangeHole10], tools = [boltCutter11])
flangeCut = subtract([flangeHole11], tools = [boltCutter12])
  |> appearance(color = flangeColor, metalness = 82, roughness = 30)
flangeBoltSketchHidden = hide(flangeBoltSketch)

leftFlange = clone(flangeCut)
  |> translate(z = -pipeLength / 2, global = true)
rightFlange = clone(flangeCut)
  |> translate(z = pipeLength / 2, global = true)

pressurePipeLocal = flatten([pipeShell, leftFlange, rightFlange])
pressurePipe = pressurePipeLocal
  |> rotate(axis = Y, angle = 90deg, global = false)

export allBodies = pressurePipe
