// HBK MK-II Hydro-Gateway assembly
// Transportable skid; stationary during operation, with no onboard propulsion modeled.
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

import skidBase from "skid_base.kcl"
import allBodies as pressurePipePart from "pressure_pipe.kcl"
import allBodies as pumpModulePart from "pump_module.kcl"
import allBodies as edgeControlCabinetPart from "edge_control_cabinet.kcl"
import allBodies as powerBackupCabinetPart from "power_backup_cabinet.kcl"
import allBodies as ioCabinetPart from "io_cabinet.kcl"
import allBodies as serviceRackPart from "service_rack.kcl"
import allBodies as meterPodPart from "meter_pod.kcl"
import allBodies as telemetryMastPart from "telemetry_mast.kcl"
import allBodies as topBeaconPart from "top_beacon.kcl"

skidTopZ = 86mm
pipeAxisZ = 310mm
rearEquipmentY = 540mm

rightServiceRackSource = clone(serviceRackPart)
outletMeterPodSource = clone(meterPodPart)

skidAssembly = skidBase

pressurePipe = pressurePipePart
  |> translate(
       x = -720mm,
       y = -690mm,
       z = pipeAxisZ,
       global = true,
     )

pumpModule = pumpModulePart
  |> rotate(axis = Z, angle = 180deg, global = false)
  |> translate(
       x = 25mm,
       y = -690mm,
       z = 340mm,
       global = true,
     )

edgeControlCabinet = edgeControlCabinetPart
  |> translate(
       x = -760mm,
       y = rearEquipmentY,
       z = 1016mm,
       global = true,
     )
powerBackupCabinet = powerBackupCabinetPart
  |> translate(
       x = 760mm,
       y = rearEquipmentY,
       z = 891mm,
       global = true,
     )
ioCabinet = ioCabinetPart
  |> translate(
       x = 700mm,
       y = -250mm,
       z = 706mm,
       global = true,
     )

leftServiceRack = serviceRackPart
  |> translate(
       x = -200mm,
       y = 650mm,
       z = 711mm,
       global = true,
     )
rightServiceRack = rightServiceRackSource
  |> translate(
       x = 200mm,
       y = 650mm,
       z = 711mm,
       global = true,
     )

inletMeterPod = meterPodPart
  |> translate(
       x = -900mm,
       y = -690mm,
       z = 732mm,
       global = true,
     )
outletMeterPod = outletMeterPodSource
  |> translate(
       x = 325mm,
       y = -690mm,
       z = 732mm,
       global = true,
     )

telemetryMast = telemetryMastPart
  |> translate(
       x = 0mm,
       y = 1040mm,
       z = skidTopZ + 950mm,
       global = true,
     )
topHeightBeacon = topBeaconPart
  |> translate(
       x = 0mm,
       y = 1040mm,
       z = 1974mm,
       global = true,
     )

hydroGatewayAssembly = flatten([
  skidAssembly,
  pressurePipe,
  pumpModule,
  edgeControlCabinet,
  powerBackupCabinet,
  ioCabinet,
  leftServiceRack,
  rightServiceRack,
  inletMeterPod,
  outletMeterPod,
  telemetryMast,
  topHeightBeacon
])

hydroGatewayAssembly
