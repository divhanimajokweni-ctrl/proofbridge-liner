// Top height beacon
// Compact stacked status beacon for the telemetry mast apex.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import unitCylinder from "unit_cylinder.kcl"

baseBody = clone(unitCylinder)
  |> scale(
       x = 76mm / 1mm,
       y = 76mm / 1mm,
       z = 34mm / 1mm,
       global = true,
     )
  |> translate(z = -42mm, global = true)
  |> appearance(color = "#59666f", metalness = 68, roughness = 40)
lightBody = clone(unitCylinder)
  |> scale(
       x = 68mm / 1mm,
       y = 68mm / 1mm,
       z = 86mm / 1mm,
       global = true,
     )
  |> translate(z = 18mm, global = true)
  |> appearance(
       color = "#5ad77a",
       metalness = 8,
       roughness = 24,
       opacity = 72,
     )
topCap = clone(unitCylinder)
  |> scale(
       x = 72mm / 1mm,
       y = 72mm / 1mm,
       z = 18mm / 1mm,
       global = true,
     )
  |> translate(z = 70mm, global = true)
  |> appearance(color = "#c8d1d6", metalness = 72, roughness = 32)

export allBodies = flatten([baseBody, lightBody, topCap])
