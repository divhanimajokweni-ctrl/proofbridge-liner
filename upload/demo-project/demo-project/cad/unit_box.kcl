// Unit box primitive
// Origin-centered one-millimeter cube for scalable assembly parts.
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

unitBoxSketch = sketch(on = XY) {
  unitBoxCenter = point(at = [var 0mm, var 0mm])
  bottomEdge = line(start = [var -0.5mm, var -0.5mm], end = [var 0.5mm, var -0.5mm])
  rightEdge = line(start = [var 0.5mm, var -0.5mm], end = [var 0.5mm, var 0.5mm])
  topEdge = line(start = [var 0.5mm, var 0.5mm], end = [var -0.5mm, var 0.5mm])
  leftEdge = line(start = [var -0.5mm, var 0.5mm], end = [var -0.5mm, var -0.5mm])

  coincident([unitBoxCenter, ORIGIN])
  coincident([bottomEdge.end, rightEdge.start])
  coincident([rightEdge.end, topEdge.start])
  coincident([topEdge.end, leftEdge.start])
  coincident([leftEdge.end, bottomEdge.start])
  horizontal(bottomEdge)
  vertical(rightEdge)
  horizontal(topEdge)
  vertical(leftEdge)
  horizontalDistance([unitBoxCenter, bottomEdge.start]) == -0.5mm
  verticalDistance([unitBoxCenter, bottomEdge.start]) == -0.5mm
  distance([bottomEdge.start, bottomEdge.end]) == 1mm
  distance([rightEdge.start, rightEdge.end]) == 1mm
}

unitBoxRegion = region(
  segments = [
    unitBoxSketch.bottomEdge,
    unitBoxSketch.rightEdge
  ],
  intersectionIndex = -1,
  direction = CCW,
)
unitBoxBody = extrude(unitBoxRegion, length = 1mm, symmetric = true)
unitBoxSketchHidden = hide(unitBoxSketch)

export unitBox = unitBoxBody
