// Service rack
// Open equipment rack with structural posts, shelves, and instrument envelopes.
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

import unitBox from "unit_box.kcl"

rackWidth = 360mm
rackDepth = 450mm
rackHeight = 1250mm
tubeSize = 32mm
frameColor = "#46535d"
shelfColor = "#87929a"
moduleColor = "#25333e"

frontLeftPost = clone(unitBox)
  |> scale(
       x = tubeSize / 1mm,
       y = tubeSize / 1mm,
       z = rackHeight / 1mm,
       global = true,
     )
  |> translate(x = -rackWidth / 2 + tubeSize / 2, y = -rackDepth / 2 + tubeSize / 2, global = true)
  |> appearance(color = frameColor, metalness = 72, roughness = 42)
frontRightPost = clone(frontLeftPost)
  |> translate(x = rackWidth - tubeSize, global = true)
rearLeftPost = clone(frontLeftPost)
  |> translate(y = rackDepth - tubeSize, global = true)
rearRightPost = clone(frontRightPost)
  |> translate(y = rackDepth - tubeSize, global = true)

bottomShelf = clone(unitBox)
  |> scale(
       x = (rackWidth - (2 * tubeSize)) / 1mm,
       y = (rackDepth - (2 * tubeSize)) / 1mm,
       z = 18mm / 1mm,
       global = true,
     )
  |> translate(z = -rackHeight / 2 + 70mm, global = true)
  |> appearance(color = shelfColor, metalness = 70, roughness = 40)
shelfTwo = clone(bottomShelf)
  |> translate(z = 300mm, global = true)
shelfThree = clone(bottomShelf)
  |> translate(z = 600mm, global = true)
topShelf = clone(bottomShelf)
  |> translate(z = 900mm, global = true)

lowerModule = clone(unitBox)
  |> scale(
       x = 270mm / 1mm,
       y = 340mm / 1mm,
       z = 190mm / 1mm,
       global = true,
     )
  |> translate(z = -rackHeight / 2 + 180mm, global = true)
  |> appearance(color = moduleColor, metalness = 42, roughness = 54)
midModule = clone(unitBox)
  |> scale(
       x = 270mm / 1mm,
       y = 340mm / 1mm,
       z = 210mm / 1mm,
       global = true,
     )
  |> translate(z = -rackHeight / 2 + 490mm, global = true)
  |> appearance(color = "#334955", metalness = 42, roughness = 54)
upperModule = clone(unitBox)
  |> scale(
       x = 270mm / 1mm,
       y = 340mm / 1mm,
       z = 190mm / 1mm,
       global = true,
     )
  |> translate(z = -rackHeight / 2 + 790mm, global = true)
  |> appearance(color = "#3c515b", metalness = 42, roughness = 54)

export allBodies = flatten([
  frontLeftPost,
  frontRightPost,
  rearLeftPost,
  rearRightPost,
  bottomShelf,
  shelfTwo,
  shelfThree,
  topShelf,
  lowerModule,
  midModule,
  upperModule
])
