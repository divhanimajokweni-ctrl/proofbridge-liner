; ============================================================================
; VENTURE VISION UBUNTU — BIND ZONE FILE
; Domain: venturevisionubuntu.co.za
; Generated: 2026-07-17
; Purpose: Clerk DNS propagation + Vercel deployment + Email authentication
; ============================================================================
; 
; INSTRUCTIONS FOR HOST AFRICA DNS PANEL:
; 1. Log in to your Host Africa client area
; 2. Navigate to DNS Management for venturevisionubuntu.co.za
; 3. Add each record below exactly as specified
; 4. Wait 24-48 hours for full propagation
; 5. Verify at https://dnschecker.org and Clerk Dashboard
;
; CLERK VERIFICATION:
; After adding records, go to dashboard.clerk.com → Configure → Domains
; and click "Verify" for venturevisionubuntu.co.za
; ============================================================================

$ORIGIN venturevisionubuntu.co.za.
$TTL 3600

; ── SOA Record ─────────────────────────────────────────────────────────────
@               IN      SOA     ns1.host-ww.net. admin.venturevisionubuntu.co.za. (
                                2026071701      ; Serial (YYYYMMDDNN)
                                3600            ; Refresh (1 hour)
                                900             ; Retry (15 minutes)
                                604800          ; Expire (1 week)
                                300             ; Minimum TTL (5 minutes)
                                )

; ── Nameservers ────────────────────────────────────────────────────────────
@               IN      NS      ns1.host-ww.net.
@               IN      NS      ns2.host-ww.net.

; ── A Records ──────────────────────────────────────────────────────────────
; Root domain → Vercel load balancer
@               IN      A       76.76.21.21

; ── CNAME Records ──────────────────────────────────────────────────────────
; Vercel deployment
www             IN      CNAME   cname.vercel-dns.com.

; Clerk Authentication — Google & Apple OAuth
; These CNAMEs are REQUIRED for Clerk to function on your custom domain.
; Without them, social sign-in (Google, Apple) will not work.
clerk           IN      CNAME   frontend-api.clerk.services.
accounts        IN      CNAME   accounts.clerk.services.

; Clerk DKIM — Email authentication for Clerk-sent emails
; These ensure emails from Clerk (verification, magic links) are not marked as spam.
clk._domainkey  IN      CNAME   dkim1.75iaamrcsqul.clerk.services.
clk2._domainkey IN      CNAME   dkim2.75iaamrcsqul.clerk.services.

; Clerk Mail — Outbound email routing
clkmail         IN      CNAME   mail.75iaamrcsqul.clerk.services.

; ── MX Records ─────────────────────────────────────────────────────────────
; Email routing (update if using Google Workspace or other email provider)
@               IN      MX      10  aspmx.l.google.com.
@               IN      MX      20  alt1.aspmx.l.google.com.
@               IN      MX      30  alt2.aspmx.l.google.com.

; ── TXT Records ────────────────────────────────────────────────────────────
; SPF — Authorize Google to send email on behalf of your domain
@               IN      TXT     "v=spf1 include:_spf.google.com ~all"

; Clerk domain verification — Proves you own this domain to Clerk
_clerk          IN      TXT     "clerk-domain-verification=venturevisionubuntu.co.za"

; DMARC — Email authentication policy
_dmarc          IN      TXT     "v=DMARC1; p=quarantine; rua=mailto:admin@venturevisionubuntu.co.za"

; ── Verification Commands ──────────────────────────────────────────────────
; After adding these records, verify propagation:
;
;   dig +short NS venturevisionubuntu.co.za
;   dig +short A venturevisionubuntu.co.za
;   dig +short CNAME clerk.venturevisionubuntu.co.za
;   dig +short CNAME accounts.venturevisionubuntu.co.za
;   dig +short CNAME clk._domainkey.venturevisionubuntu.co.za
;   dig +short CNAME clk2._domainkey.venturevisionubuntu.co.za
;   dig +short CNAME clkmail.venturevisionubuntu.co.za
;
; Expected results:
;   NS: ns1.host-ww.net. ns2.host-ww.net.
;   A:  76.76.21.21
;   clerk: frontend-api.clerk.services.
;   accounts: accounts.clerk.services.
;   clk._domainkey: dkim1.75iaamrcsqul.clerk.services.
;   clk2._domainkey: dkim2.75iaamrcsqul.clerk.services.
;   clkmail: mail.75iaamrcsqul.clerk.services.
;
; Clerk Dashboard: https://dashboard.clerk.com/apps → Configure → Domains
; ============================================================================
