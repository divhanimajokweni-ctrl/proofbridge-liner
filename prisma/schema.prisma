generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String   // hashed password
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claims    Claim[]
}

model Claim {
  id          String   @id @default(cuid())
  title       String
  description String
  claimType   String   @default("empirical")
  state       String   @default("UNTESTED")
  intendedAction String @default("deploy")
  safetyCritical Boolean @default(true)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  evidence       Evidence[]
  authorizations Authorization[]
  circuitEvents  CircuitBreaker[]
  nIndRecords    NIndComputation[]

  @@index([state])
  @@index([claimType])
  @@index([userId])
}

model Evidence {
  id          String   @id @default(cuid())
  claimId     String
  claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  source      String
  content     String
  embedding   String
  weight      Float    @default(1.0)
  state       String   @default("OBSERVED")
  collectedAt DateTime @default(now())

  @@index([claimId])
  @@index([source])
}

model Authorization {
  id            String   @id @default(cuid())
  claimId       String
  claim         Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  claimOk       Boolean
  evidenceOk    Boolean
  integrityOk   Boolean
  safetyOk      Boolean
  reviewOk      Boolean
  authorized    Boolean
  reason        String   @default("")
  createdAt     DateTime @default(now())

  @@index([claimId])
  @@index([authorized])
}

model CircuitBreaker {
  id            String   @id @default(cuid())
  claimId       String
  claim         Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  triggered     Boolean  @default(false)
  reason        String   @default("")
  trippedAt     DateTime @default(now())

  @@index([claimId])
  @@index([triggered])
}

model NIndComputation {
  id            String   @id @default(cuid())
  claimId       String
  claim         Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  numEvidence   Int
  numSources    Int
  nInd          Float
  gamma         Float
  eigenvalues   String   @default("[]")
  createdAt     DateTime @default(now())

  @@index([claimId])
}

model HeatKernelStep {
  id            String   @id @default(cuid())
  claimId       String
  step          Int
  l2Norm        Float
  highFreqEnergy Float
  nodeValues    String   @default("[]")
  createdAt     DateTime @default(now())

  @@index([claimId])
}

// ─────────────────────────────────────────────────────────────────
// E2E Blockchain-Compiled Models (VVUIVELedger.sol / Arbitrum Sepolia)
// ─────────────────────────────────────────────────────────────────

model LedgerClaim {
  id           String   @id @default(cuid())
  claimId      String   @unique
  state        String   @default("UNKNOWN")
  evidenceRoot String?
  previousHash String?
  verifier     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  evidence       LedgerEvidence[]
  authorization  LedgerAuthorization?

  @@index([state])
}

model LedgerEvidence {
  id          String   @id @default(cuid())
  claimId     String
  claim       LedgerClaim @relation(fields: [claimId], references: [claimId], onDelete: Cascade)
  bundleHash  String
  arweaveTxId String?
  source      String
  createdAt   DateTime @default(now())

  @@index([claimId])
  @@index([source])
}

model LedgerAuthorization {
  id        String   @id @default(cuid())
  claimId   String   @unique
  claim     LedgerClaim @relation(fields: [claimId], references: [claimId], onDelete: Cascade)
  C         Boolean  @default(false)
  E         Boolean  @default(false)
  I         Boolean  @default(false)
  S         Boolean  @default(false)
  R         Boolean  @default(false)
  granted   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@index([granted])
}

model CircuitBreakerLog {
  id        String   @id @default(cuid())
  state     String   @default("NORMAL")
  reason    String?
  timestamp DateTime @default(now())

  @@index([state])
}

model LedgerNIndComputation {
  id                String   @id @default(cuid())
  claimId           String
  nInd              Float
  lambda2           Float
  participationRatio Float?
  createdAt         DateTime @default(now())

  @@index([claimId])
}
