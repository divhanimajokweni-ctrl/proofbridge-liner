// Epistemic Runtime — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A compiled .epd policy stored in the runtime.
model Policy {
  id          String   @id @default(cuid())
  name        String   @unique
  filename    String
  source      String
  domain      String?
  version     String?
  description String?
  ok          Boolean  @default(true)
  errorCount  Int      @default(0)
  warningCount Int     @default(0)
  invariantCount Int   @default(0)
  shardCount  Int      @default(0)
  shardKey    String?
  shardStrategy String?
  repairStrategy String?
  zkEnabled   Boolean  @default(false)
  proofKind   String?
  shadowEnabled Boolean @default(false)
  takeoverLatencyMs Int?
  wasmFingerprint String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shards     Shard[]
  merges     MergeProposal[]
  proofs     AncestryProof[]
  violations InvariantViolation[]
  shadowEvents ShadowEvent[]
  mined      MinedInvariant[]
  revisions  PolicyRevision[]

  @@index([domain])
}

// A historical revision of a policy's .epd source (versioning).
model PolicyRevision {
  id          String   @id @default(cuid())
  policyId    String
  policy      Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  version     Int      // sequential revision number
  source      String   // the .epd source at this revision
  wasmFingerprint String?
  invariantCount Int   @default(0)
  changeSummary String? // short description of what changed
  author      String?
  createdAt   DateTime @default(now())

  @@index([policyId])
  @@unique([policyId, version])
}

// A shard owning a subset of the state space for a policy.
model Shard {
  id         String   @id @default(cuid())
  policyId   String
  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  shardKey   String
  region     String
  nodeId     String
  state      String   // JSON
  invariantStatus String // "healthy" | "repairing" | "violating"
  mmrRoot    String
  peerCount  Int      @default(0)
  lastMergeAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merges     MergeProposal[]

  @@index([policyId])
  @@index([shardKey])
}

// A merge proposal between two shards, possibly self-repaired.
model MergeProposal {
  id           String   @id @default(cuid())
  policyId     String
  policy       Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  sourceShardId String?
  sourceShard  Shard?   @relation(fields: [sourceShardId], references: [id], onDelete: SetNull)
  targetShard  String
  sourceShardName String
  proposedState String   // JSON
  repairedState String?  // JSON
  status       String   // pending | repairing | applied | rejected
  violations   String   // JSON array of names
  divergence   Float    @default(0)
  iterations   Int      @default(0)
  mmrProof     String
  zkProof      String?
  createdAt    DateTime @default(now())

  @@index([policyId])
  @@index([status])
}

// An MMR ancestry proof anchored for a policy/shard.
model AncestryProof {
  id         String   @id @default(cuid())
  policyId   String
  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  shardKey   String
  mmrRoot    String
  proofPath  String   // JSON array of sibling hashes
  zkProof    String?
  anchored   Boolean  @default(false)
  anchor     String?  // rekor | blockchain | transparency_log
  createdAt  DateTime @default(now())

  @@index([policyId])
}

// A recorded invariant violation (for the miner / drift log).
model InvariantViolation {
  id         String   @id @default(cuid())
  policyId   String
  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  invariant  String
  severity   String
  soft       Boolean  @default(false)
  shardKey   String
  actual     String?
  expected   String?
  repaired   Boolean  @default(false)
  driftDelta Float?
  createdAt  DateTime @default(now())

  @@index([policyId])
  @@index([invariant])
}

// Shadow bridge events: what-if branches, takeovers, replays.
model ShadowEvent {
  id         String   @id @default(cuid())
  policyId   String
  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  kind       String   // takeover | whatif | replay | divergence | handback
  summary    String
  liveState  String   // JSON
  shadowState String  // JSON
  divergence Float    @default(0)
  authoritative Boolean @default(false)
  createdAt  DateTime @default(now())

  @@index([policyId])
  @@index([kind])
}

// Candidate invariants proposed by the AI miner.
model MinedInvariant {
  id         String   @id @default(cuid())
  policyId   String?
  policy     Policy?  @relation(fields: [policyId], references: [id], onDelete: SetNull)
  predicate  String
  rationale  String
  confidence Float
  severity   String
  accepted   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Append-only Fact Log — the kernel's event store.
// WORM: No updates, no deletes. Every fact that passes the AcceptancePipeline.
model FactLog {
  id             String   @id // SHA-256 of canonical bytes (deterministic)
  type           String   // observation | migration_* | projection_* | etc.
  body           String   // JSON — the fact payload
  canonicalBytes String   // RFC 8785 canonical JSON
  hash           String   // SHA-256 hash of canonicalBytes
  sequence       Int      // Monotonically increasing
  timestamp      Int      // Logical timestamp from injected clock
  submittedBy    String   // Identity that submitted this fact
  signature      String   // Ed25519 signature over canonicalBytes
  acceptedAt     Int      // When the acceptance pipeline accepted this fact
  schemaId       String   // Schema that validated this fact's body
  mmrRoot        String?  // MMR root at time of insertion
  createdAt      DateTime @default(now())

  @@index([type])
  @@index([sequence])
  @@index([submittedBy])
}

// ── HBK Mk-II Applied Research Programme ────────────────────────────────

// Resource tracking for the Founding 100 campaign.
model HbkResource {
  id            String   @id @default(cuid())
  resource      String   // e.g. "Laptops", "Desks"
  qtyNeeded     Int      @default(0)
  qtyCommitted  Int      @default(0)
  unit          String   // e.g. "units", "GB/month"
  partnerType   String   // e.g. "Technology Partner", "Academic Partner"
  status        String   @default("open") // secured | in_progress | open | urgent
  category      String   // operations | engineering | connectivity | field-ops | workshop | branding
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  commitments HbkCommitment[]

  @@index([status])
  @@index([category])
}

// Individual partner commitments for specific resources.
model HbkCommitment {
  id            String   @id @default(cuid())
  resourceId    String
  resource      HbkResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  partnerName   String   // Organization name
  partnerContact String? // Contact person
  partnerEmail  String?
  qty           Int      @default(1)
  status        String   @default("pledged") // pledged | confirmed | delivered
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([resourceId])
  @@index([status])
}

// Git Actions Log for the HBK digital twin engineering process.
model HbkGitAction {
  id            String   @id @default(cuid())
  action        String   // commit | push | merge | deploy | test | validate
  branch        String
  message       String
  author        String
  hash          String
  status        String   @default("success") // success | running | failed
  createdAt     DateTime @default(now())

  @@index([action])
  @@index([branch])
  @@index([createdAt])
}

// 72h Validation simulation phases tracking.
model HbkValidationPhase {
  id            String   @id @default(cuid())
  phaseId       String   @unique // v1-v7
  name          String
  duration      String   // e.g. "0-4h"
  status        String   @default("pending") // complete | active | pending | failed
  description   String
  metricsJson   String   // JSON array of { label, value, status }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}
