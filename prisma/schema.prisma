// VVU — Verification Village Universe
// IVE (Integrated Verification Environment) — persistence schema
// EIS (Evidence Independence Specification) — backend logic lives in src/lib/eis

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE VVU IVE MODELS
// ============================================================================

model Claim {
  id            String   @id @default(cuid())
  title         String
  description   String
  claimType     String   @default("empirical")
  state         String   @default("UNTESTED")
  intendedAction String @default("deploy")
  safetyCritical Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  evidence       Evidence[]
  authorizations Authorization[]
  circuitEvents  CircuitBreaker[]
  nIndRecords    NIndComputation[]

  @@index([state])
  @@index([claimType])
}

model Evidence {
  id            String   @id @default(cuid())
  claimId       String
  claim         Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  source        String
  content       String
  embedding     String
  weight        Float    @default(1.0)
  state         String   @default("OBSERVED")
  collectedAt   DateTime @default(now())

  @@index([claimId])
  @@index([source])
}

model Authorization {
  id            String   @id @default(cuid())
  claimId       String
  claim         Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  claimOk       Boolean
  evidenceOk    Boolean
  integrityOk   Boolean
  safetyOk      Boolean
  reviewOk      Boolean
  authorized    Boolean
  reason        String   @default("")
  createdAt     DateTime @default(now())

  @@index([claimId])
  @@index([authorized])
}

model CircuitBreaker {
  id            String   @id @default(cuid())
  claimId       String
  claim         Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  triggered     Boolean  @default(false)
  reason        String   @default("")
  trippedAt     DateTime @default(now())

  @@index([claimId])
  @@index([triggered])
}

model NIndComputation {
  id            String   @id @default(cuid())
  claimId       String
  claim         Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  numEvidence   Int
  numSources    Int
  nInd          Float
  gamma         Float
  eigenvalues   String   @default("[]")
  createdAt     DateTime @default(now())

  @@index([claimId])
}

model HeatKernelStep {
  id              String   @id @default(cuid())
  claimId         String
  step            Int
  l2Norm          Float
  highFreqEnergy  Float
  nodeValues      String   @default("[]")
  createdAt       DateTime @default(now())

  @@index([claimId])
}

// ============================================================================
// WEBHOOK DELIVERY SUBSYSTEM — VVU-IVE Reliability Contract v1.1
// ============================================================================

model Webhook {
  id          String   @id @default(cuid())
  name        String
  url         String
  type        String   @default("custom")
  secret      String   @default("")
  nextSecret  String?  @default(null)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries      WebhookDelivery[]
  cbState         WebhookCircuitBreakerState?

  @@index([enabled])
}

model WebhookSecretAudit {
  id            String   @id @default(cuid())
  webhookId     String
  oldSecretHash String
  newSecretHash String
  rotatedBy     String
  reason        String   @default("scheduled")
  rotatedAt     DateTime @default(now())

  @@index([webhookId])
  @@index([rotatedAt])
}

model WebhookDelivery {
  id              String   @id @default(cuid())
  webhookId       String
  webhook         Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventId         String
  payload         String
  status          String   @default("PENDING")
  statusReason    String   @default("")
  kafkaPartition  Int?
  kafkaOffset     Int?
  attempts        WebhookDeliveryAttempt[]
  dlqEntries      DeadLetterQueueEntry[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([webhookId])
  @@index([status])
  @@index([eventId])
}

model WebhookDeliveryAttempt {
  id            String   @id @default(cuid())
  deliveryId    String
  delivery      WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attemptNumber Int
  httpStatus    Int      @default(0)
  outcome       String
  responseBody  String   @default("")
  delayMs       Int      @default(0)
  startedAt     DateTime @default(now())
  finishedAt    DateTime?

  @@index([deliveryId])
  @@index([outcome])
}

model WebhookCircuitBreakerState {
  id                    String   @id @default(cuid())
  webhookId             String   @unique
  webhook               Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  state                 String   @default("CLOSED")
  terminalFailureCount  Int      @default(0)
  openedAt              DateTime?
  halfOpenProbeAt       DateTime?
  halfOpenProbeResult   String?
  updatedAt             DateTime @updatedAt
}

model DeadLetterQueueEntry {
  id              String   @id @default(cuid())
  deliveryId      String?
  webhookId       String
  eventId         String
  reason          String
  finalHttpStatus Int      @default(0)
  payload         String
  replayedBy      String   @default("")
  replayedAt      DateTime?
  createdAt       DateTime @default(now())

  delivery        WebhookDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  @@index([webhookId])
  @@index([reason])
  @@index([replayedAt])
  @@index([deliveryId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  type       String
  webhookId  String   @default("")
  deliveryId String   @default("")
  attemptId  String   @default("")
  details    String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([type])
  @@index([webhookId])
  @@index([deliveryId])
  @@index([createdAt])
}

// ============================================================================
// GOVERNANCE
// ============================================================================

model StudiGate {
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  description String   @default("")
  status      String   @default("PENDING")
  note        String   @default("")
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([status])
}
