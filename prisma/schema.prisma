// =============================================================================
// VVU Sovereign Database Schema · vvu-pis-db-schema-20260901
// Multi-tenant Row-Level Security (RLS) · POPIA-compliant · SANS 1200
// Mirrors the sovereign DB initialised by vvu-init-db-20260901.sh
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Tenant isolation root ─────────────────────────────────────────────────
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  anchors       GeographicAnchor[]
  nodes         PhysicalNode[]
  spools        PipeSpoolProfile[]
  invariants    HydraulicInvariant[]
  telemetryLogs TelemetryLog[]
  auditLogs     AuditLog[]
  ledgerEntries LedgerEntry[]
}

// ─── WGS84 → ECEF reference coordinates ────────────────────────────────────
model GeographicAnchor {
  id          String   @id @default(cuid())
  tenantId    String
  siteName    String
  latitude    Float
  longitude   Float
  originEcefX Float
  originEcefY Float
  originEcefZ Float
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─── ENU coordinates (mm) for all hardware modules ─────────────────────────
model PhysicalNode {
  id            String   @id @default(cuid())
  tenantId      String
  componentName String
  xEnuMm        Float
  yEnuMm        Float
  zEnuMm        Float
  functionalRole String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─── SANS/EN structural calibration (DN100, DN300) ─────────────────────────
model PipeSpoolProfile {
  id               String   @id @default(cuid())
  tenantId         String
  nominalSize      String
  outerDiameterMm  Float
  innerDiameterMm  Float
  wallThicknessMm  Float
  materialGrade    String
  flangeStandard   String
  boltSpecification String
  targetTorqueNm   Float
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─── Safe-harbour hydraulic bounds (wave celerity, FAVAD, corrosion) ───────
model HydraulicInvariant {
  id                     String  @id @default(cuid())
  tenantId               String
  minWaveCelerityMs      Float   @default(200.0)
  maxWaveCelerityMs      Float   @default(1400.0)
  minFavadExponent       Float   @default(0.5)
  maxFavadExponent       Float   @default(2.5)
  maxSacrificialCorrosionMm Float @default(10.0)
  minFactorOfSafety      Float   @default(1.5)
  maxFactorOfSafety      Float   @default(3.0)
  createdAt              DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─── Edge telemetry ingestion (RLS-scoped) ─────────────────────────────────
model TelemetryLog {
  id               String   @id @default(cuid())
  tenantId         String
  nodeId           String
  flowRate         Float
  pressureHead     Float
  acousticAbnormal Boolean  @default(false)
  apuTemperature   Float
  systemState      String   @default("STEADY_STATE")
  estimatedCelerity Float
  invariantOk      Boolean  @default(true)
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([nodeId])
  @@index([createdAt])
}

// ─── Append-only audit trail (state transitions, key rotations) ────────────
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  actor     String
  action    String
  fromState String?
  toState   String?
  symbol    String?
  reason    String?
  metadata  String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
}

// ─── WORM evidence store (SHA-256 canonical bytes) ─────────────────────────
model LedgerEntry {
  id         String   @id @default(cuid())
  tenantId   String
  fileId     String
  filename   String
  sha256     String
  sizeBytes  Int
  verified   Boolean  @default(true)
  tampered   Boolean  @default(false)
  commitHash String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([fileId])
  @@unique([tenantId, fileId])
}
